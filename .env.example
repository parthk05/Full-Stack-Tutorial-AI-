# Copy to `.env` and fill in real values (`.env` is gitignored).
# Lesson 02 Phase 1.3 — Configuration

# MySQL — SQLAlchemy URL (driver: pymysql)
MYSQL_URL=mysql+pymysql://root:YOUR_PASSWORD@localhost:3306/fastapi_books

# MongoDB
MONGODB_URI=mongodb://localhost:27017
MONGODB_DATABASE=fastapi_books

# Optional pagination defaults
DEFAULT_PAGE_SIZE=50
MAX_PAGE_SIZE=100
